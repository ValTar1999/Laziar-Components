{
  "name": "laziar",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "ng": "ng",
    "start": "ng serve docs",
    "start:docs": "ng serve docs",
    "build": "ng build docs",
    "build:docs": "ng build docs",
    "build:gh-pages": "ng build docs --configuration production --base-href /Laziar-Components/",
    "build:lib": "ng build components",
    "publish:lib": "node scripts/publish-lib.mjs",
    "watch": "ng build docs --watch --configuration development",
    "test": "ng test",
    "test:ci": "ng test components --watch=false --browsers=ChromeHeadlessCI && ng test docs --watch=false --browsers=ChromeHeadlessCI",
    "lint": "ng lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "endOfLine": "auto",
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "lint-staged": {
    "*.{ts,html}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{scss,css,json,md}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@angular/animations": "21.2.26",
    "@angular/cdk": "~21.2.14",
    "@angular/common": "^21.2.26",
    "@angular/compiler": "^21.2.26",
    "@angular/core": "^21.2.26",
    "@angular/forms": "^21.2.26",
    "@angular/platform-browser": "^21.2.26",
    "@angular/router": "^21.2.26",
    "@floating-ui/dom": "^1.8.0",
    "@fontsource/bitter": "^5.3.0",
    "@fontsource/lora": "^5.3.0",
    "@fontsource/onest": "^5.3.1",
    "@jsverse/transloco": "^8.4.0",
    "rxjs": "~7.8.0",
    "swiper": "^14.4.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.29",
    "@angular/cli": "^21.2.29",
    "@angular/compiler-cli": "^21.2.26",
    "@types/jasmine": "~5.1.0",
    "angular-eslint": "^21.4.0",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "jasmine-core": "~5.9.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "lint-staged": "^16.4.0",
    "ng-packagr": "^21.2.7",
    "prettier": "^3.9.6",
    "typescript": "~5.9.2",
    "typescript-eslint": "8.46.4"
  }
}
