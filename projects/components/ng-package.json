{
  "$schema": "../../node_modules/ng-packagr/ng-package.schema.json",
  "dest": "../../dist/components",
  "keepLifecycleScripts": true,
  "lib": {
    "entryFile": "src/public-api.ts"
  },
  "assets": [
    {
      "glob": "**/*",
      "input": "src/styles",
      "output": "styles"
    },
    {
      "glob": "**/*",
      "input": "src/assets/icons",
      "output": "assets/icons"
    },
    {
      "glob": "copy-icon-assets.cjs",
      "input": "scripts",
      "output": "scripts"
    }
  ]
}
